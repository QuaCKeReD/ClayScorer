# Copy to .env and adjust.

# First admin account — created on first start only, when no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Host port the app is published on.
HTTP_PORT=8080

# Set to true when the app is served over HTTPS (behind a TLS reverse proxy).
COOKIE_SECURE=false

# How long a sign-in lasts on a device.
SESSION_DAYS=30

# User/group the container runs as; must be able to write ./data.
# On Linux use the output of `id -u` / `id -g` for the owner of ./data.
PUID=1000
PGID=1000
